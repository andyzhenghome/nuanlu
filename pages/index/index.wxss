/* pages/index/index.wxss — 首页 */

/* 搜索栏 */
.search-wrap {
  padding: 20rpx 24rpx 4rpx;
}
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 44rpx;
  padding: 18rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 80, 40, 0.06);
}
.search-ico {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
}
.search-ph {
  color: var(--text-3);
  font-size: 26rpx;
}

/* ===== 三大入口宫格 ===== */
.nav-grid {
  display: flex;
  padding: 36rpx 16rpx 28rpx;
}
.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.nav-badge {
  width: 108rpx;
  height: 108rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(232, 84, 30, 0.15);
}
.badge-fire    { background: linear-gradient(145deg, #ffe3d3, #ffd0b8); }
.badge-parts   { background: linear-gradient(145deg, #fff0d6, #ffe3b8); }
.badge-install { background: linear-gradient(145deg, #ffe3d3, #ffcbb0); }
.nav-icon-img {
  width: 72rpx;
  height: 72rpx;
}
.nav-name {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}
.nav-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

/* ===== 轮播 ===== */
.banner {
  height: 220rpx;
  margin: 8rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
}
.banner-item {
  height: 100%;
  box-sizing: border-box;
  padding: 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.banner-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
}
.banner-sub {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
}

/* ===== 区块标题 ===== */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 28rpx 16rpx;
}
.section-more {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ===== 热销横滑 ===== */
.hot-scroll { width: 100%; white-space: nowrap; }
.hot-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 0 24rpx 8rpx;
}
.hot-card {
  width: 300rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(120, 80, 40, 0.06);
}
.hot-img {
  height: 180rpx;
  position: relative;
  overflow: hidden;
  background: #f5f5f5;
}
.hot-photo {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}
.hot-info {
  padding: 18rpx 20rpx 22rpx;
  white-space: normal;
}
.hot-name {
  font-size: 26rpx;
  font-weight: 600;
  display: block;
}
.hot-spec {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
.hot-sales {
  font-size: 20rpx;
  color: var(--text-3);
}

/* ===== 智能选炉入口 ===== */
.picker-entry {
  margin: 28rpx 24rpx 0;
  background: linear-gradient(120deg, #fff6ef, #ffead9);
  border: 2rpx solid #ffd9bf;
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  display: flex;
  align-items: center;
}
.picker-left { flex: 1; display: flex; flex-direction: column; }
.picker-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #b34a17;
}
.picker-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a86b4a;
}
.picker-btn {
  background: linear-gradient(135deg, #f26a2e, #e8541e);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 32rpx;
  border-radius: 36rpx;
}
