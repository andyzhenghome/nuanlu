<!-- pages/install/install.wxml — 安装服务预约 -->
<view class="page page-enter">

  <!-- ===== 安装进度追踪（有预约时显示） ===== -->
  <view wx:if="{{booking}}" class="card track-card">
    <view class="track-head">
      <text class="section-title">安装进度</text>
      <text class="track-status">{{steps[booking.step]}}</text>
    </view>
    <view class="timeline">
      <view wx:for="{{steps}}" wx:key="*this" class="tl-item">
        <view class="tl-dot {{booking.step >= index ? (booking.step === index ? 'cur' : 'done') : ''}}">
          <text wx:if="{{booking.step > index}}">✓</text>
        </view>
        <view class="tl-line {{booking.step > index ? 'on' : ''}}" wx:if="{{index < steps.length - 1}}"></view>
        <view class="tl-body">
          <text class="tl-name {{booking.step >= index ? 'active' : ''}}">{{item}}</text>
          <text class="tl-time" wx:if="{{booking.times[index]}}">{{booking.times[index]}}</text>
        </view>
      </view>
    </view>

    <!-- 师傅信息（接单后展示） -->
    <view wx:if="{{booking.step >= 1}}" class="worker-card">
      <view class="worker-avatar">{{workerInitial}}</view>
      <view class="col flex-1">
        <text class="worker-name">{{worker.name}}
          <text class="worker-rating">⭐ {{worker.rating}}分</text>
        </text>
        <text class="text-3">已服务 {{worker.orderCount}} 单</text>
      </view>
      <button class="call-btn" bindtap="callWorker">拨打师傅电话</button>
    </view>

    <!-- 演示：模拟师傅进度推进 -->
    <view wx:if="{{booking.step < steps.length - 1}}" class="demo-link" bindtap="demoAdvance">
      演示：模拟师傅进度更新（{{booking.step + 1}}/4）
    </view>
  </view>

  <!-- ===== 服务说明 ===== -->
  <view class="card">
    <text class="block-title">📋 服务说明</text>
    <view wx:for="{{guarantees}}" wx:key="*this" class="guarantee-item">
      <text class="g-check">✅</text>
      <text class="g-text">{{item}}</text>
    </view>
  </view>

  <!-- ===== 收费标准 ===== -->
  <view class="card">
    <text class="block-title">💰 收费标准</text>
    <view wx:for="{{fees}}" wx:key="name" class="fee-row">
      <view class="col">
        <text class="fee-name">{{item.name}}</text>
        <text class="text-3">{{item.note}}</text>
      </view>
      <text class="fee-price {{item.price === '免费' ? 'free' : ''}}">{{item.price}}</text>
    </view>
  </view>

  <!-- ===== 预约安装 ===== -->
  <view class="card">
    <text class="block-title">📝 预约安装</text>

    <!-- 关联订单 -->
    <picker mode="selector" range="{{orders}}" range-key="label" value="{{orderIndex}}" bindchange="onOrderPick">
      <view class="form-row">
        <text class="form-label">关联订单</text>
        <view class="flex-1"></view>
        <text class="form-value {{orderIndex < 0 ? 'ph' : ''}}">
          {{orderIndex >= 0 ? orders[orderIndex].label : '请选择已购炉子订单'}}
        </text>
        <text class="form-arrow">›</text>
      </view>
    </picker>
    <view wx:if="{{orders.length === 0}}" class="no-order">暂无已签收订单可关联，可直接电话联系预约：{{shop.phone}}</view>

    <!-- 安装地址 -->
    <view class="form-row align-top">
      <text class="form-label">安装地址</text>
      <textarea class="form-textarea" value="{{addr}}" placeholder="选择订单后自动带入，可修改"
        placeholder-class="ph" bindinput="onAddr"></textarea>
    </view>

    <!-- 预约日期（未来7天，约满置灰） -->
    <text class="form-label date-label">预约日期</text>
    <scroll-view scroll-x class="date-strip" enhanced show-scrollbar="{{false}}">
      <view class="date-list">
        <view wx:for="{{dateList}}" wx:key="value"
          class="date-item {{item.full ? 'full' : ''}} {{dateIndex === index ? 'on' : ''}}"
          data-i="{{index}}" bindtap="onDatePick">
          <text class="date-wd">{{item.weekday}}</text>
          <text class="date-d">{{item.day}}</text>
          <text class="date-full" wx:if="{{item.full}}">已约满</text>
        </view>
      </view>
    </scroll-view>

    <!-- 时间段 -->
    <text class="form-label date-label">时间段</text>
    <view class="slot-row">
      <view class="slot {{slotIndex === 0 ? 'on' : ''}}" data-i="0" bindtap="onSlotPick">上午 8:00-12:00</view>
      <view class="slot {{slotIndex === 1 ? 'on' : ''}}" data-i="1" bindtap="onSlotPick">下午 13:00-18:00</view>
    </view>

    <!-- 备注 -->
    <view class="form-row align-top" style="margin-top:8rpx;">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" value="{{remark}}" placeholder="选填，如特殊需求、到村口接师傅"
        placeholder-class="ph" bindinput="onRemark"></textarea>
    </view>

    <button class="btn-primary submit-btn" bindtap="submit">提交预约</button>
  </view>

  <!-- ===== 需要帮助 ===== -->
  <view class="card help-card">
    <text class="block-title">📞 需要帮助？</text>
    <view class="help-row">
      <text class="text-2">客服电话：{{shop.phone}}（{{shop.contact}}）</text>
      <button class="help-btn" bindtap="callService">在线咨询</button>
    </view>
  </view>

</view>
