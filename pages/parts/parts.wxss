/* pages/parts/parts.wxss — 配件耗材（左分类 + 右商品） */

.parts-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部搜索 */
.top-bar {
  padding: 18rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid var(--line);
}
.search-input {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 44rpx;
  padding: 16rpx 26rpx;
}
.search-ico { width: 32rpx; height: 32rpx; margin-right: 12rpx; }
.search-input input { flex: 1; font-size: 27rpx; }
.ph { color: var(--text-3); }
.search-clear {
  width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center;
  border-radius: 50%; background: #d8d8d8; color: #fff; font-size: 28rpx;
}

/* 主体：左右分栏 */
.parts-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧分类 */
.cat-side {
  width: 220rpx;
  background: #f7f7f7;
  height: 100%;
}
.cat-item {
  position: relative;
  padding: 34rpx 20rpx;
  text-align: center;
  min-height: 88rpx;
  box-sizing: border-box;
}
.cat-name {
  font-size: 27rpx;
  color: var(--text-2);
}
.cat-item.on {
  background: #fff;
}
.cat-item.on .cat-name {
  color: var(--brand);
  font-weight: 700;
}
.cat-bar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 0;
  background: var(--brand);
  border-radius: 0 4rpx 4rpx 0;
  transition: height 0.2s;
}
.cat-item.on .cat-bar {
  height: 44rpx;
}

/* 右侧商品 */
.prod-side {
  flex: 1;
  height: 100%;
  background: #fff;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.side-tip {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  padding: 24rpx 8rpx 12rpx;
}
.side-empty {
  text-align: center;
  color: var(--text-3);
  padding: 100rpx 0;
  font-size: 26rpx;
}

.prod-card {
  display: flex;
  padding: 24rpx 8rpx;
  border-bottom: 2rpx solid var(--line);
}
.prod-img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  background: #faf5f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.prod-img-txt {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--brand);
}
.prod-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.prod-name {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.4;
}
.prod-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
}
.add-btn {
  margin-left: auto;
  background: var(--brand);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 30rpx;
  border-radius: 32rpx;
  min-height: 56rpx;
  line-height: 32rpx;
  box-sizing: border-box;
}

/* 浮动购物车 */
.cart-fab {
  position: fixed;
  right: 28rpx;
  bottom: 60rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #ff8a4c, #ff6b35);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(255, 107, 53, 0.4);
  z-index: 50;
}
.cart-ico { width: 56rpx; height: 56rpx; }
.cart-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 18rpx;
  background: #f0382f;
  color: #fff;
  font-size: 22rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
}
.cart-fab.bounce {
  animation: cartBounce 0.45s;
}
@keyframes cartBounce {
  0% { transform: scale(1); }
  35% { transform: scale(1.25); }
  60% { transform: scale(0.92); }
  100% { transform: scale(1); }
}
