/* pages/detail/detail.wxss */

.hero {
  height: 420rpx;
  position: relative;
  overflow: hidden;
  background: #f5f5f5;
}
.hero-photo {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}
.hero-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 160rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.55), rgba(0,0,0,0));
}
.hero-name {
  position: absolute;
  left: 32rpx;
  bottom: 28rpx;
  z-index: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 4rpx 16rpx rgba(0,0,0,0.5);
}

.price-card {
  background: #fff;
  padding: 24rpx 28rpx;
}
.tags { margin-top: 16rpx; }

/* 参数 */
.params { padding: 8rpx 28rpx; }
.param-row {
  display: flex;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.param-row:last-child { border-bottom: none; }
.param-label {
  width: 180rpx;
  color: var(--text-2);
  font-size: 27rpx;
}
.param-val {
  flex: 1;
  font-size: 27rpx;
  font-weight: 600;
}

.desc-text {
  display: block;
  margin-top: 18rpx;
  font-size: 27rpx;
  color: var(--text-2);
  line-height: 1.7;
}

/* 底部操作条 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  gap: 16rpx;
  box-shadow: 0 -4rpx 20rpx rgba(120, 80, 40, 0.08);
}
.bb-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 90rpx;
}
.bb-icon { font-size: 38rpx; }
.bb-text { font-size: 20rpx; color: var(--text-2); }
.bb-btn { flex: 1; margin: 0; }
