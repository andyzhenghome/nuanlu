<!-- pages/stove-list/stove-list.wxml — 燃煤采暖炉列表 -->
<view class="page page-enter">

  <!-- 搜索框 -->
  <view class="search-row">
    <view class="search-input">
      <image class="search-ico" src="/images/icon-search.png" mode="aspectFit"></image>
      <input value="{{keyword}}" placeholder="搜索型号，如 NL-100" placeholder-class="ph"
        confirm-type="search" bindinput="onKeyword" focus="{{focus}}" />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword">×</text>
    </view>
  </view>

  <!-- 筛选栏：系列 Tab（横向滚动） -->
  <scroll-view scroll-x class="series-bar" enhanced show-scrollbar="{{false}}">
    <view class="series-tabs">
      <view wx:for="{{seriesTabs}}" wx:key="key"
        class="series-tab {{seriesFilter === item.key ? 'on' : ''}}"
        data-key="{{item.key}}" bindtap="onSeriesTap">{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 排序栏 -->
  <view class="sort-bar">
    <view wx:for="{{sortOptions}}" wx:key="key"
      class="sort-item {{sortBy === item.key ? 'on' : ''}}"
      data-key="{{item.key}}" bindtap="onSortTap">
      {{item.label}}
      <text wx:if="{{item.key === 'price'}}" class="sort-arrow">{{priceArrow}}</text>
    </view>
    <view class="sort-item area-btn {{areaFilter !== 'all' ? 'on' : ''}}" bindtap="openAreaPanel">
      {{areaLabel}}
      <text class="sort-arrow">▾</text>
    </view>
  </view>

  <!-- 双列商品卡片 -->
  <view class="goods-grid" wx:if="{{list.length > 0}}">
    <view class="goods-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="goods-img img-stove">
        <text class="goods-series">{{item.seriesLabel}}</text>
        <text class="goods-model">{{item.model}}</text>
      </view>
      <view class="goods-body">
        <text class="goods-name">{{item.name}}</text>
        <view class="goods-tags">
          <text wx:for="{{item.services}}" wx:for-item="srv" wx:key="*this" class="tag tag-srv">{{srv}}</text>
        </view>
        <text class="goods-spec">{{item.area}} · {{item.power}}kW</text>
        <view class="goods-bottom">
          <text class="price"><text class="yen">¥</text><text class="num">{{item.priceText}}</text></text>
        </view>
        <text class="goods-sales">已售 {{item.sales}} · 好评 {{item.rating}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && list.length === 0}}" class="empty">
    <text class="empty-icon">🔍</text>
    <text>没有找到符合条件的采暖炉</text>
    <text class="text-3" style="margin-top:12rpx;">换个型号或清空筛选试试</text>
  </view>

  <!-- 底部加载状态 -->
  <view class="load-status" wx:if="{{list.length > 0}}">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:elif="{{!hasMore}}">没有更多了</text>
  </view>

  <!-- 面积筛选面板 -->
  <view wx:if="{{areaPanelShow}}" class="mask" bindtap="closeAreaPanel">
    <view class="area-panel" catchtap="noop">
      <view class="panel-title">按适用面积筛选</view>
      <view class="area-grid">
        <view wx:for="{{areaOptions}}" wx:key="key"
          class="area-opt {{areaFilter === item.key ? 'on' : ''}}"
          data-key="{{item.key}}" bindtap="onAreaPick">{{item.label}}</view>
      </view>
      <view class="panel-btns">
        <view class="panel-btn ghost" bindtap="resetArea">重置</view>
        <view class="panel-btn primary" bindtap="closeAreaPanel">确定</view>
      </view>
    </view>
  </view>

</view>
