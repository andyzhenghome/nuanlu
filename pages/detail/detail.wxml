<!-- pages/detail/detail.wxml — 商品详情 -->
<view class="page" wx:if="{{item}}">

  <!-- 商品主图（渐变占位 + 型号） -->
  <view class="hero">
    <text class="hero-model">{{item.model}}</text>
    <text class="hero-name">{{item.name}}</text>
  </view>

  <!-- 价格区 -->
  <view class="price-card">
    <view class="row">
      <text class="price" style="margin-top:10rpx;"><text class="yen">¥</text><text class="num">{{item.priceText}}</text></text>
      <view class="flex-1"></view>
      <text class="text-3">已售 {{item.sales}} 台</text>
    </view>
    <view class="tags">
      <text wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" class="tag tag-hot">{{t}}</text>
    </view>
  </view>

  <!-- 参数 -->
  <view class="card params">
    <view class="param-row">
      <text class="param-label">额定功率</text>
      <text class="param-val">{{item.power}} kW</text>
    </view>
    <view class="param-row">
      <text class="param-label">适用面积</text>
      <text class="param-val">{{item.area}}</text>
    </view>
    <view class="param-row">
      <text class="param-label">型号</text>
      <text class="param-val">{{item.model}}</text>
    </view>
    <view class="param-row">
      <text class="param-label">配送</text>
      <text class="param-val">周边乡镇免费送，远郊加运费</text>
    </view>
  </view>

  <!-- 说明 -->
  <view class="card">
    <text class="section-title">商品说明</text>
    <text class="desc-text">{{item.desc}}</text>
    <text class="desc-text">本商品为农村家用燃煤采暖炉，可接暖气片/地暖，带封火功能过夜不灭火。支持上门安装（另收安装费）。</text>
  </view>

  <view style="height: 140rpx;"></view>

  <!-- 底部操作条 -->
  <view class="bottom-bar safe-bottom">
    <view class="bb-item" bindtap="callService">
      <text class="bb-icon">📞</text>
      <text class="bb-text">客服</text>
    </view>
    <button class="btn-ghost bb-btn" bindtap="addCart">加入清单</button>
    <button class="btn-primary bb-btn" bindtap="buyNow">立即下单</button>
  </view>

</view>
