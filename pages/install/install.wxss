/* pages/install/install.wxss — 安装服务 */

.block-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

/* ===== 进度追踪 ===== */
.track-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.track-status {
  font-size: 24rpx;
  color: #fff;
  background: var(--brand);
  padding: 8rpx 22rpx;
  border-radius: 28rpx;
}
.timeline {
  padding: 8rpx 0;
}
.tl-item {
  position: relative;
  display: flex;
  padding-bottom: 36rpx;
}
.tl-item:last-child { padding-bottom: 0; }
.tl-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #e8e8e8;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 2;
}
.tl-dot.done { background: #52c41a; }
.tl-dot.cur {
  background: var(--brand);
  box-shadow: 0 0 0 8rpx rgba(255, 107, 53, 0.18);
}
.tl-line {
  position: absolute;
  left: 19rpx;
  top: 44rpx;
  width: 4rpx;
  height: 72rpx;
  background: #e8e8e8;
}
.tl-line.on { background: #52c41a; }
.tl-body {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.tl-name {
  font-size: 28rpx;
  color: var(--text-3);
}
.tl-name.active {
  color: var(--text);
  font-weight: 700;
}
.tl-time {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

/* 师傅卡片 */
.worker-card {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 24rpx;
  background: var(--brand-light);
  border-radius: 16rpx;
}
.worker-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.worker-name {
  font-size: 30rpx;
  font-weight: 700;
  margin-left: 16rpx;
}
.worker-rating {
  font-size: 24rpx;
  color: #d48806;
  font-weight: 400;
  margin-left: 12rpx;
}
.worker-card .text-3 { margin-left: 16rpx; margin-top: 6rpx; }
.call-btn {
  background: var(--brand);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  margin: 0;
}
.call-btn::after { border: none; }

.demo-link {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
  padding: 12rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
}

/* ===== 服务说明 ===== */
.guarantee-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.g-check { margin-right: 14rpx; font-size: 28rpx; }
.g-text { font-size: 27rpx; color: var(--text-2); }

/* ===== 收费标准 ===== */
.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.fee-row:last-child { border-bottom: none; }
.fee-name { font-size: 28rpx; font-weight: 600; }
.fee-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--price);
}
.fee-price.free { color: #52c41a; }

/* ===== 预约表单 ===== */
.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.form-row.align-top { align-items: flex-start; }
.form-label {
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.form-value { font-size: 28rpx; }
.ph { color: var(--text-3); }
.form-arrow {
  margin-left: 10rpx;
  color: var(--text-3);
  font-size: 34rpx;
}
.form-textarea {
  flex: 1;
  min-height: 90rpx;
  margin-left: 20rpx;
  font-size: 28rpx;
}
.no-order {
  padding: 16rpx 0;
  font-size: 24rpx;
  color: var(--brand);
}

.date-label {
  display: block;
  margin: 24rpx 0 16rpx;
}
.date-strip { white-space: nowrap; }
.date-list { display: inline-flex; gap: 16rpx; }
.date-item {
  width: 130rpx;
  padding: 18rpx 0;
  text-align: center;
  border-radius: 12rpx;
  background: #f7f7f7;
  border: 2rpx solid transparent;
}
.date-item.on {
  background: var(--brand-light);
  border-color: var(--brand);
}
.date-wd { font-size: 24rpx; color: var(--text-2); display: block; }
.date-item.on .date-wd { color: var(--brand); font-weight: 700; }
.date-d { font-size: 28rpx; font-weight: 700; display: block; margin-top: 6rpx; }
.date-item.full {
  background: #f5f5f5;
  opacity: 0.6;
}
.date-full {
  font-size: 18rpx;
  color: var(--text-3);
  display: block;
  margin-top: 4rpx;
}

.slot-row { display: flex; gap: 20rpx; }
.slot {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 24rpx 0;
  border-radius: 12rpx;
  border: 2rpx solid var(--line);
  background: #fafafa;
  min-height: 88rpx;
  box-sizing: border-box;
}
.slot.on {
  background: var(--brand-light);
  border-color: var(--brand);
  color: var(--brand);
  font-weight: 700;
}

.submit-btn {
  margin-top: 40rpx;
  width: 100%;
}

/* ===== 客服 ===== */
.help-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.help-btn {
  background: var(--brand-light);
  color: var(--brand);
  font-size: 26rpx;
  padding: 12rpx 30rpx;
  border-radius: 32rpx;
  margin: 0;
}
.help-btn::after { border: none; }
