<!-- pages/my/my.wxml — 我的 -->
<view class="page page-enter">

  <view class="profile">
    <view class="avatar">客</view>
    <view class="col" style="margin-left:24rpx;">
      <text class="nickname">顾客朋友</text>
      <text class="text-3">农村采暖 · 一站式服务</text>
    </view>
  </view>

  <!-- 电话咨询入口 -->
  <view class="stat card">
    <view class="stat-item" bindtap="callService">
      <text class="stat-num">📞</text>
      <text class="stat-label">电话咨询</text>
    </view>
  </view>

  <!-- 店铺信息 -->
  <view class="card shop-card">
    <view class="shop-head">
      <text class="shop-brand">🏭 {{shop.brand}}</text>
      <text class="shop-loc">山东·淄博</text>
    </view>
    <view class="shop-row">
      <text class="shop-label">厂址</text>
      <text class="shop-val">{{shop.address}}</text>
    </view>
    <view class="shop-row">
      <text class="shop-label">联系人</text>
      <text class="shop-val">{{shop.contact}} · {{shop.phone}}</text>
    </view>
    <button class="btn-primary shop-call" bindtap="callService">拨打电话</button>
  </view>

  <view class="about">暖炉到家 v1.0 · 让农村冬天更暖和</view>
</view>
